---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	validate_input(validate_input)
	plan(plan)
	retrieve(retrieve)
	generate(generate)
	critique(critique)
	finalize(finalize)
	__end__([<p>__end__</p>]):::last
	__start__ --> validate_input;
	critique -.-> finalize;
	critique -.-> retrieve;
	generate --> critique;
	plan --> retrieve;
	retrieve -.-> generate;
	validate_input -.-> finalize;
	validate_input -.-> plan;
	finalize --> __end__;
	retrieve -.-> retrieve;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
