# Copy to .env and fill in. .env is gitignored; never commit a real key.

# ── Required: the agent's generation model ────────────────────────────────────
# Gemini 2.5 Flash-Lite free tier. Get a key at https://aistudio.google.com/app/apikey
# Free-tier content may be used to improve Google's products — acceptable here because the
# corpus is public arXiv text. See docs/DECISIONS.md D-001.
GOOGLE_API_KEY=

# ── Optional: Hugging Face ────────────────────────────────────────────────────
# Only needed if BAAI/bge-large-en download is rate-limited without a token.
HF_TOKEN=

# ── Optional: model routing ───────────────────────────────────────────────────
# Provider-prefixed, resolved by langchain's init_chat_model. A provider swap is a config
# change, not a code change.
# AGENT_MODEL=google_genai:gemini-3.5-flash-lite
# AGENT_TEMPERATURE=0.0
# Thinking budget. Pinned, never defaulted — thinking tokens bill at the output rate.
# minimal | low | medium | high. Measured: "low" costs ~6x "minimal" on the same prompt.
# AGENT_REASONING_EFFORT=minimal

# ── Optional: per-request budget ceilings ─────────────────────────────────────
# Nested settings use a double underscore. Breaching any ceiling returns a partial answer
# with an explicit truncation flag — never a silent stop.
# BUDGET__MAX_INPUT_TOKENS=120000
# BUDGET__MAX_OUTPUT_TOKENS=12000
# BUDGET__MAX_NOTIONAL_COST_USD=0.05
# BUDGET__MAX_WALL_CLOCK_S=120
# BUDGET__MAX_TOOL_CALLS=12
# BUDGET__MAX_LLM_CALLS=16

# ── Optional: graph bounds ────────────────────────────────────────────────────
# GRAPH__MAX_REFINEMENTS=2
# GRAPH__MAX_SUB_QUESTIONS=4
# GRAPH__RECURSION_LIMIT=25

# ── Optional: retrieval ───────────────────────────────────────────────────────
# Section filtering ships disabled: the classifier's precision is unvalidated and Phase 4
# has not yet measured whether it helps. See docs/DECISIONS.md D-003.
# RETRIEVAL__TOP_K=5
# RETRIEVAL__SPARSE_FALLBACK_THRESHOLD=5
# RETRIEVAL__ENABLE_SECTION_FILTER=false

# ── Optional: device ──────────────────────────────────────────────────────────
# auto | cpu | mps | cuda. Index rebuilds are only reproducible with cpu (DECISIONS D-006).
# DEVICE=auto

# ── Observability (Phase 3) ───────────────────────────────────────────────────
# Langfuse. Everything degrades to a no-op when these are blank: an unreachable tracing
# backend is never a reason a query fails.
#   make langfuse-up      -> http://localhost:3000, sign up, create a project, copy keys
# Langfuse Cloud is the alternative: https://cloud.langfuse.com (or us.cloud.langfuse.com)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=http://localhost:3000
# Tags every trace, so a dev instance and a deployed one stay separable.
# LANGFUSE_ENVIRONMENT=development
# RELEASE=0.1.0

# OpenTelemetry for retrieval/embedding spans. When Langfuse is on, these nest inside the
# Langfuse trace automatically and neither of these needs setting.
# OTLP_ENDPOINT=http://localhost:4318/v1/traces
# OTEL_CONSOLE_EXPORT=false

# ── Phase 4 (not used yet) ────────────────────────────────────────────────────
# Evaluation judge only. Never the agent's generator. Budget: $5 total, see docs/BUDGET.md
# OPENAI_API_KEY=
