# Copy to .env and fill in. .env is gitignored; never commit a real key.

# ── Required: the agent's generation model ────────────────────────────────────
# Get a key at https://aistudio.google.com/app/apikey. CHECK WHICH TIER IT IS ON: a key in a
# Google Cloud project with billing enabled is billed at paid rates, whatever this project
# assumes — every run to date was, $7.60 in all (docs/DECISIONS.md D-046). A free-tier key
# (project with no billing account) is not billed, and its prompts may be used to improve
# Google's products — acceptable only because the corpus is public arXiv text.
GOOGLE_API_KEY=

# ── Optional: Hugging Face ────────────────────────────────────────────────────
# Only needed if BAAI/bge-large-en download is rate-limited without a token.
HF_TOKEN=

# ── Optional: model routing ───────────────────────────────────────────────────
# Provider-prefixed, resolved by langchain's init_chat_model. A provider swap is a config
# change, not a code change.
# AGENT_MODEL=google_genai:gemini-3.5-flash-lite
# AGENT_TEMPERATURE=0.0
# Thinking budget. Pinned, never defaulted — thinking tokens bill at the output rate.
# minimal | low | medium | high. Measured: "low" costs ~6x "minimal" on the same prompt.
# AGENT_REASONING_EFFORT=minimal

# ── Optional: per-request budget ceilings ─────────────────────────────────────
# Nested settings use a double underscore. Breaching any ceiling returns a partial answer
# with an explicit truncation flag — never a silent stop.
# BUDGET__MAX_INPUT_TOKENS=120000
# BUDGET__MAX_OUTPUT_TOKENS=12000
# BUDGET__MAX_NOTIONAL_COST_USD=0.025
# BUDGET__MAX_WALL_CLOCK_S=120
# BUDGET__MAX_TOOL_CALLS=12
# BUDGET__MAX_LLM_CALLS=16

# ── Optional: graph bounds ────────────────────────────────────────────────────
# GRAPH__MAX_REFINEMENTS=2
# GRAPH__MAX_SUB_QUESTIONS=4
# GRAPH__RECURSION_LIMIT=25

# ── Optional: retrieval ───────────────────────────────────────────────────────
# Section filtering ships disabled: the classifier's precision is unvalidated and Phase 4
# has not yet measured whether it helps. See docs/DECISIONS.md D-003.
# RETRIEVAL__TOP_K=5
# RETRIEVAL__SPARSE_FALLBACK_THRESHOLD=5
# RETRIEVAL__ENABLE_SECTION_FILTER=false

# ── Optional: device ──────────────────────────────────────────────────────────
# auto | cpu | mps | cuda. Index rebuilds are only reproducible with cpu (DECISIONS D-006).
# DEVICE=auto

# ── Observability (Phase 3) ───────────────────────────────────────────────────
# Langfuse. Everything degrades to a no-op when these are blank: an unreachable tracing
# backend is never a reason a query fails.
#   make langfuse-up      -> http://localhost:3000, sign up, create a project, copy keys
# Langfuse Cloud is the alternative: https://cloud.langfuse.com (or us.cloud.langfuse.com)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=http://localhost:3000
# Tags every trace, so a dev instance and a deployed one stay separable.
# LANGFUSE_ENVIRONMENT=development
# RELEASE=0.1.0

# OpenTelemetry for retrieval/embedding spans. When Langfuse is on, these nest inside the
# Langfuse trace automatically and neither of these needs setting.
# OTLP_ENDPOINT=http://localhost:4318/v1/traces
# OTEL_CONSOLE_EXPORT=false

# Head sampling for Langfuse, 0..1. Default 1.0 traces every request; 0.30 is the rate that
# fits the daily ceiling's worst case inside Langfuse Cloud Hobby (`make trace-units`). The
# service refuses to start if a configured rate is not actually in effect (DECISIONS D-039).
# LANGFUSE_SAMPLE_RATE=1.0

# ── Serving (Phase 5) — docs/SERVING.md ───────────────────────────────────────
# Pace model calls, per minute; 0 = off (the default, so the eval path is unpaced). The
# container sets 12, with a burst of 3: at most 15 in any minute, the free-tier quota.
# AGENT_REQUESTS_PER_MINUTE=0
# The scope classifier runs with seed=0, top_k=1 (DECISIONS D-035). false reproduces the
# configuration Phase 4's metrics were measured with.
# PIN_SCOPE_CLASSIFIER=true
# Where graph checkpoints (threads) live. On a host without a volume they are lost on restart.
# CHECKPOINT_DB=.checkpoints/threads.sqlite
#
# The image sets API__DEPLOYED=true, which makes it refuse to start on a daily cost ledger
# that forgets on restart. Choose one:
#   API__LEDGER=sqlite  with API__LEDGER_PATH on a mounted volume (Fly.io, docker -v)
#   API__LEDGER=upstash with the two UPSTASH_* values below (hosts with no persistent disk)
# API__LEDGER=memory
# API__LEDGER_PATH=.checkpoints/ledger.sqlite
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# API__DAILY_NOTIONAL_CEILING_USD=0.50
# API__PER_IP_PER_MINUTE=4
# API__PER_IP_BURST=3
# API__MAX_CONCURRENT_QUERIES=2
# API__QUEUE_TIMEOUT_S=20
# Proxies in front of the service that append to X-Forwarded-For. 0 trusts only the socket
# peer. Set per host after observing its headers, never by guess.
# API__TRUSTED_PROXY_HOPS=0
# Lets the load check skip the per-IP bucket only (not the ceiling or the gate). Unset = no
# bypass exists. Use a long random value: `openssl rand -hex 24`.
# LOADCHECK_TOKEN=

# ── Phase 4: evaluation judge ─────────────────────────────────────────────────
# Evaluation judge only. Never the agent's generator. Budget: $5 total, see docs/BUDGET.md
# OPENAI_API_KEY=
